NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Replicate API credentials and owner/model identifiers (server-side only)
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=
REPLICATE_VIDEO_MODEL=
REPLICATE_WEBHOOK_SECRET=

# Each model has a different input schema. Set a JSON template matching the
# exact model API. The adapter replaces {{prompt}} and {{aspect_ratio}}.
REPLICATE_IMAGE_INPUT_TEMPLATE={"prompt":"{{prompt}}","aspect_ratio":"{{aspect_ratio}}"}
REPLICATE_VIDEO_INPUT_TEMPLATE={"prompt":"{{prompt}}","aspect_ratio":"{{aspect_ratio}}"}

# Credit costs are reserved transactionally before provider submission.
LUMI_IMAGE_CREDIT_COST=1
LUMI_VIDEO_CREDIT_COST=10
LUMI_MAX_UPLOAD_MB=20

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe one-time credit checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
